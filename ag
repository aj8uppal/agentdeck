def main(argv):
    cmd = argv[0] if argv else 'ls'
    if cmd == 'check':
        return check()
    if cmd == 'stream':
        return stream()
    if cmd == 'talk':
        return talk(''.join(argv[1:2]))
    if cmd == 'send':  # the text is read first, so the state check below is as late as it can be
        sid = argv[argv.index('--sid') + 1] if '--sid' in argv[:-1] else ''
        return send(''.join(argv[1:2]), sys.stdin.read(), '--no-submit' not in argv, sid)
    if cmd not in ('ls', 'watch', 'peek', 'json', 'go', 'next'):
        return print(__doc__)
    rows = snapshot(load(argv[-1]) if cmd == 'json' else None)
    if cmd == 'ls':
        print(table(rows, sys.stdout.isatty()))
    elif cmd == 'watch':
        while True:
            if not sh('pgrep', '-f', 'Agentdeck.app/Contents/MacOS/Agentdeck'):  # the app raises its own, clickable banners
                notify(rows)
            sys.stdout.write('\033[H\033[2J' + table(rows, True) + '\n')
            sys.stdout.flush()
            time.sleep(2)
            rows = snapshot()
    elif cmd == 'peek':
        peek(rows, argv[1] if len(argv) > 1 else None)
    elif cmd == 'json':
        if '--notify' in argv:
            notify(rows)
        print(as_json(rows))
    else:
        if cmd == 'go':
            row = next((r for r in rows if r['where'] == ''.join(argv[1:2])), None)
        else:
            clients = load(sh(wezterm(processes()), 'cli', 'list-clients', '--format', 'json')) or [{}]
            row = pick_next(rows, clients[0].get('focused_pane_id'))
        if not row:
            sys.exit('no such tab' if cmd == 'go' else 'nothing needs you')
        jump(row)


if __name__ == '__main__':
    try:
        main(sys.argv[1:])
    except KeyboardInterrupt:
        pass
    except BrokenPipeError:  # the reader went away (`ag stream | head`, or the app quit)
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
